#!/usr/bin/env python3
"""Validate a non-normative MNCS language evidence profile."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from mncs_validator.language_profiles import validate_language_profile_file


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("profile", type=Path)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    try:
        errors = validate_language_profile_file(args.profile)
    except (OSError, UnicodeError, ValueError, json.JSONDecodeError) as exc:
        errors = [str(exc)]
    result = {
        "profile": str(args.profile),
        "profile_valid": not errors,
        "errors": errors,
        "claim": "profile-valid only; no MNCS or MNCDS conformance is inferred",
    }
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    elif errors:
        print("INVALID language evidence profile", file=sys.stderr)
        for error in errors:
            print(f"- {error}", file=sys.stderr)
    else:
        print(f"PROFILE-VALID: {args.profile}")
    return 0 if not errors else 1


if __name__ == "__main__":
    raise SystemExit(main())
