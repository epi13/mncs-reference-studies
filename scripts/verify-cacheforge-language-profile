#!/usr/bin/env python3
"""Verify the CacheForge Python-profile amendment without changing claims."""

from __future__ import annotations

import json
from pathlib import Path
from typing import Any

from jsonschema import Draft202012Validator

ROOT = Path(__file__).resolve().parents[1]


def load(path: Path) -> Any:
    return json.loads(path.read_text(encoding="utf-8"))


def main() -> int:
    profile_path = (
        ROOT
        / "experimental/language-evidence/profiles"
        / "python-cpython-3.11-v0.1.json"
    )
    schema_path = ROOT / "schemas/mncs-language-evidence-profile.schema.json"
    amendment_path = (
        ROOT
        / "case-studies/cacheforge"
        / "python-language-profile-epoch-3.json"
    )

    profile = load(profile_path)
    schema = load(schema_path)
    errors = list(Draft202012Validator(schema).iter_errors(profile))
    if errors:
        raise SystemExit(errors[0].message)

    amendment = load(amendment_path)
    checks = [
        amendment["selected_profile"] == profile["profile_id"],
        amendment["historical_evidence_modified"] is False,
        amendment["claim_boundary"]["formal_mncs_status"] == "UNKNOWN",
        amendment["claim_boundary"]["formal_mncds_status"] == "UNKNOWN",
        amendment["claim_boundary"]["promotion_authorized"] is False,
        amendment["provider"]["result"] == "UNKNOWN",
    ]
    if not all(checks):
        raise SystemExit("CacheForge language-profile amendment is inconsistent")

    result = {
        "status": "PASS",
        "amendment_id": amendment["amendment_id"],
        "claim": "profile binding only; historical claims unchanged",
    }
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
